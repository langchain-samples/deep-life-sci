#!/usr/bin/env bash
#
# One-time setup (`--help` for the invocations). Run this once per clone, then ask
# questions with ./run_sci_agent.
#
# Five steps, in the order they depend on each other:
#
#   1. uv          — installs Python 3.12+ too, so it is the only Python prerequisite
#   2. .env        — two API keys, prompted for and written here
#   3. uv sync     — the virtualenv
#   4. a snapshot  — sandbox image with the scientific Python stack baked in
#   5. the chat UI — the frontend, and the deps for the components it renders
#
# Step 4 needs step 3 (it imports langsmith) and step 2 (it calls LangSmith), which is
# why this is a script rather than a list in the README. Every step is skipped when
# already done, so re-running after a `git pull` is the cheap way to catch up.
#
# The chat UI is not optional and has no flag: it is how this agent is meant to be used,
# and a headless-only install is the unusual case rather than the default. It comes last
# so that a machine without Node still ends up with a working `uv run agent`.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

ENV_FILE="$ROOT/.env"
ASSUME_YES=false

# These three are duplicated in run_sci_agent rather than sourced from a shared file, so
# either script still works alone. Keep the placeholder rule in `env_value` identical in
# both: they disagree only in the direction of "setup wrote a key run_sci_agent won't
# accept."
say() { echo "[setup] $*"; }
die() { echo "[setup] $*" >&2; exit 1; }

env_value() {  # env_value <KEY> — the value in .env, empty if unset or still a placeholder
  local v
  v="$(sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | head -1)"
  # .env.example ships `KEY=lsv2_sk_...` as a hint. A trailing `...` is that hint, not a
  # key someone pasted, so it counts as unset.
  [[ $v == *... ]] && v=""
  printf '%s' "$v"
}

# A heredoc rather than a sed slice of the header: a line range breaks silently the next
# time someone edits a comment above it.
usage() {
  cat <<'EOF'
One-time setup for the PubMed/PMC research agent. Run once per clone, then use
./run_sci_agent.

  ./setup_sci_agent        prompt for the two API keys, install everything
  -y, --yes                never prompt; for CI and containers

Safe to re-run: every step is skipped when already done.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes) ASSUME_YES=true ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
  shift
done

# A prompt only makes sense with someone there to answer it. Under `-y`, or when stdin is
# a pipe, every ask falls back to its default instead of blocking forever.
interactive() { [[ $ASSUME_YES == false && -t 0 ]]; }

confirm() {  # confirm <question> — default yes
  interactive || return 0
  local reply
  read -r -p "[setup] $1 [Y/n] " reply
  [[ -z $reply || $reply =~ ^[Yy] ]]
}

# --- 1. uv ------------------------------------------------------------------------
#
# uv also provisions the interpreter, so a machine with the wrong Python — or no Python —
# still works from here. That is the point of depending on it rather than on pip and a
# venv the user has to create themselves.
ensure_uv() {
  command -v uv >/dev/null 2>&1 && return
  # A uv that is installed but absent from this shell's PATH needs the PATH fix, not a
  # second install, so try its env file before offering to download anything.
  # shellcheck disable=SC1091
  [[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
  command -v uv >/dev/null 2>&1 && return

  say "uv is not installed. It manages both the dependencies and the Python version."
  confirm "install uv from https://astral.sh/uv ?" \
    || die "nothing installed. Install it yourself: https://docs.astral.sh/uv/"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  # shellcheck disable=SC1091
  [[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
  export PATH="$HOME/.local/bin:$PATH"
  command -v uv >/dev/null 2>&1 \
    || die "uv installed but not on PATH — open a new shell and re-run this script."
  say "uv installed."
}

# --- 2. .env ----------------------------------------------------------------------

set_env() {  # set_env <KEY> <VALUE> — rewrite the KEY= line in place, or append it
  local key=$1 value=$2
  if grep -q "^${key}=" "$ENV_FILE"; then
    # Values go through the environment rather than `awk -v`, which would expand a
    # backslash in a pasted key as an escape sequence.
    _k="$key" _v="$value" awk '
      BEGIN { k = ENVIRON["_k"]; v = ENVIRON["_v"] }
      !done && index($0, k "=") == 1 { print k "=" v; done = 1; next }
      { print }
    ' "$ENV_FILE" > "$ENV_FILE.tmp"
    mv "$ENV_FILE.tmp" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

ask_key() {  # ask_key <KEY> <prompt> <expected prefix> — required, loops until answered
  local key=$1 prompt=$2 prefix=$3 reply
  [[ -n "$(env_value "$key")" ]] && return
  interactive \
    || die "$key is not set in .env, and there is no terminal to ask on. Add it and re-run."
  while :; do
    read -r -p "[setup] $prompt: " reply
    reply="${reply//[[:space:]]/}"
    [[ -z $reply ]] && continue
    # A wrong-but-plausible key is the failure this catches: a real OpenAI key in
    # OPENAI_API_KEY looks right and dies 200 lines deep in the SDK at the first model
    # call. Queried rather than rejected outright — key formats belong to the gateway and
    # may change, so the last word is the user's.
    if [[ -n $prefix && $reply != $prefix* ]]; then
      local anyway
      say "that doesn't start with '$prefix' — see the note in .env.example."
      read -r -p "[setup] use it anyway? [y/N] " anyway
      [[ $anyway =~ ^[Yy] ]] || continue
    fi
    set_env "$key" "$reply"
    return
  done
}

ask_optional() {  # ask_optional <KEY> <prompt> — blank is a valid answer
  local key=$1 prompt=$2 reply
  interactive || return 0
  read -r -p "[setup] $prompt (optional, Enter to skip): " reply
  reply="${reply//[[:space:]]/}"
  [[ -n $reply ]] && set_env "$key" "$reply"
  return 0
}

ensure_env() {
  local fresh=false
  if [[ ! -f $ENV_FILE ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    fresh=true
    say "created .env from .env.example"
  fi

  # Two keys, both from LangSmith (https://smith.langchain.com/settings), and easy to mix
  # up: model calls are billed and authenticated as *gateway* compute under a service key,
  # while tracing and sandbox provisioning use the personal API key.
  ask_key OPENAI_API_KEY \
    "LangSmith gateway service key for model calls (lsv2_sk_..., NOT an OpenAI key)" \
    "lsv2_sk_"
  ask_key LANGSMITH_API_KEY \
    "LangSmith API key for tracing and sandboxes (lsv2_pt_...)" \
    "lsv2_"

  # Only offered on a first run. These are genuinely optional, so re-asking on every
  # setup would be nagging someone who already decided to skip them.
  if [[ $fresh == true ]]; then
    say "NCBI credentials are optional: they raise PubMed's rate limit from 3 to 10 req/s."
    ask_optional NCBI_API_KEY "NCBI API key"
    ask_optional NCBI_EMAIL "contact email for NCBI (their usage policy asks for one)"
  fi
}

# --- 3. dependencies --------------------------------------------------------------
#
# The dev group too, unconditionally: it is only langgraph-cli, and syncing it here is
# what keeps `run_sci_agent chat` from stalling on an install after it has already
# claimed the ports.
ensure_deps() {
  say "syncing dependencies…"
  uv sync --group dev --quiet
}

# --- 4. sandbox snapshot ----------------------------------------------------------
#
# Optional in the sense that a missing snapshot is slow rather than broken — sandbox.py
# falls back to a ~30s pip install per run — but 35s once is the better trade, so it is
# built here rather than left as a step someone can skip. It is also why run_sci_agent
# does not check for it: a per-run LangSmith round trip to re-learn something setup
# already guaranteed.
#
# SNAPSHOT_NAME is imported rather than re-read from .env so this can never check for a
# different name than the agent boots from.
#
# The probe is a function that only *prints* the program, so the heredoc never sits inside
# a command substitution. macOS ships bash 3.2, whose parser scans `$( ... )` for the
# closing paren without honouring heredoc bodies, and a lone apostrophe in a comment
# there is a syntax error in the whole script.
_snapshot_probe() {
  cat <<'PY'
import os

from dotenv import load_dotenv

# Explicit path: bare load_dotenv() locates .env by walking the calling stack frame, and
# this program arrives on stdin, where there is no caller frame to walk.
load_dotenv(os.environ["START_ENV_FILE"], override=True)

from langsmith.sandbox import SandboxClient

from research_agent.sandbox import SNAPSHOT_NAME

names = {s.name for s in SandboxClient().list_snapshots(name_contains=SNAPSHOT_NAME)}
print("present" if SNAPSHOT_NAME in names else "missing")
PY
}

ensure_snapshot() {
  local status
  status="$(_snapshot_probe | START_ENV_FILE="$ENV_FILE" uv run --quiet python - 2>&1 || true)"

  case "$status" in
    *present) say "sandbox snapshot ready." ;;
    *missing)
      say "building the sandbox snapshot (~35s, once)…"
      uv run scripts/build_snapshot.py
      ;;
    *)
      # Reaching LangSmith at all failed, so this is a credentials or connectivity problem
      # and every run would have it too. Fail here, where the cause is visible.
      echo "$status" >&2
      die "could not reach LangSmith. Check LANGSMITH_API_KEY in .env."
      ;;
  esac
}

# --- 5. chat UI -------------------------------------------------------------------
#
# Vendored *inside* the repo, at .chat-ui, rather than beside it: a sibling directory is
# outside what the user cloned and is not necessarily writable. The cost is that
# `langgraph build` uses the repo root as its Docker context, so .chat-ui has to be listed
# in .dockerignore or a dev-only frontend ships in the deploy image.
#
# Only the /ui/* rewrite is reapplied on each run. It is load-bearing — without it the artifact
# components silently render nothing (see CLAUDE.md) — and it is a one-key insert. The
# other patch CLAUDE.md documents, the ai.tsx whitespace fix, is cosmetic and edits a
# component body, so it stays a manual choice rather than something rewritten underneath
# whoever made it.
UI_REPO="https://github.com/langchain-ai/agent-chat-ui.git"
CHAT_UI_DIR="${AGENT_CHAT_UI:-$ROOT/.chat-ui}"

patch_next_config() {
  local cfg="$CHAT_UI_DIR/next.config.mjs"
  if [[ ! -f $cfg ]]; then
    say "warning: no next.config.mjs in $CHAT_UI_DIR; skipped the /ui/* rewrite."
    return 0
  fi
  grep -q "/ui/:path" "$cfg" && return 0

  # Upstream currently has no `rewrites` key and one `const nextConfig = {` to insert
  # after. If either stops being true, print the snippet instead of guessing: a second
  # `rewrites` key would silently shadow the first rather than fail.
  if grep -q "rewrites" "$cfg" || ! grep -q "^const nextConfig = {" "$cfg"; then
    say "warning: $cfg is not the shape expected. Add this to its config by hand:"
    cat <<'EOF'
  async rewrites() {
    return [
      { source: "/ui/:path*", destination: "http://localhost:2024/ui/:path*" },
    ];
  },
EOF
    return 0
  fi

  awk '
    !done && /^const nextConfig = \{/ {
      print
      print "  // setup_sci_agent: artifact components load /ui/* from the page origin, so"
      print "  // this proxy is what makes them render at all. See CLAUDE.md."
      print "  async rewrites() {"
      print "    return ["
      print "      { source: \"/ui/:path*\", destination: \"http://localhost:2024/ui/:path*\" },"
      print "    ];"
      print "  },"
      done = 1
      next
    }
    { print }
  ' "$cfg" > "$cfg.tmp"
  mv "$cfg.tmp" "$cfg"
  say "added the /ui/* rewrite to next.config.mjs"
}

# Node is a real prerequisite, not a nicety: pnpm builds the frontend and npm installs the
# artifact components. pnpm is offered automatically because npm can install it in one
# command; Node itself is left to the user, since installing a language runtime unasked is
# a larger liberty than installing a package manager. Reached only after the four steps
# above, so the message can truthfully say the headless path already works.
ensure_node() {
  if ! command -v npm >/dev/null 2>&1; then
    say "everything else is ready — ask questions now with:  uv run agent \"your question\""
    say "the chat UI needs Node 20+: https://nodejs.org, or \`brew install node\` on a Mac."
    die "install it and re-run this script to add the UI."
  fi
  command -v pnpm >/dev/null 2>&1 && return
  # agent-chat-ui pins pnpm as its package manager and ships only a pnpm lockfile, so this
  # is not a substitutable choice between equivalent tools.
  confirm "the chat UI needs pnpm. install it with \`npm install -g pnpm\` ?" \
    || die "install pnpm yourself (https://pnpm.io/installation), then re-run."
  npm install -g pnpm
  command -v pnpm >/dev/null 2>&1 \
    || die "pnpm installed but not on PATH — open a new shell and re-run this script."
}

ensure_chat_ui() {
  command -v git >/dev/null 2>&1 || die "the chat UI needs git."

  if [[ ! -d $CHAT_UI_DIR ]]; then
    say "cloning agent-chat-ui into ${CHAT_UI_DIR#"$ROOT/"}…"
    git clone --depth 1 --quiet "$UI_REPO" "$CHAT_UI_DIR"
  fi

  patch_next_config

  # Without this the UI opens on a form asking for a deployment URL and assistant id.
  # `.env.local` because Next reads it ahead of `.env` and upstream ignores `*.local`.
  # The id is the graph name in langgraph.json.
  if [[ ! -f $CHAT_UI_DIR/.env.local ]]; then
    printf 'NEXT_PUBLIC_API_URL=http://localhost:2024\nNEXT_PUBLIC_ASSISTANT_ID=agent\n' \
      > "$CHAT_UI_DIR/.env.local"
    say "pointed the UI at localhost:2024"
  fi

  [[ -d $CHAT_UI_DIR/node_modules ]] && return
  say "installing frontend dependencies (~1 min, once)…"
  ( cd "$CHAT_UI_DIR" && pnpm install --silent )
}

# The artifact components in ui/ are bundled by the *graph server*, not by the frontend, so
# their dependencies are part of wanting a UI at all rather than of the clone above. They
# fail silently when missing: the bundler logs `Could not resolve "xlsx"`, still answers
# /ui/<graph>/entrypoint.js with a 200, and the chart is simply absent — indistinguishable
# from the missing-rewrite failure. `npm ci` rather than `npm install` because
# ui/package-lock.json is tracked for exactly this reason.
ensure_artifact_deps() {
  [[ -d $ROOT/ui/node_modules ]] && return
  say "installing artifact component dependencies…"
  ( cd "$ROOT/ui" && npm ci --silent )
}

ensure_uv
ensure_env
ensure_deps
ensure_snapshot
ensure_node
ensure_chat_ui
ensure_artifact_deps

say "setup complete."
say "open the chat UI with:  ./run_sci_agent"
say "or ask one question headlessly:  ./run_sci_agent \"your question\""
