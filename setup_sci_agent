#!/usr/bin/env bash
#
# One-time setup, for macOS and Linux. A convenience wrapper: it installs uv if you don't
# have it, then hands over to `scripts/setup.py`, which is where the actual work lives and
# is what Windows users run directly.
#
#   ./setup_sci_agent        prompt for the two API keys, install everything
#   ./setup_sci_agent -y     never prompt; for CI and containers
#
# Safe to re-run: every step is skipped when already done.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# uv is the one thing setup cannot do from inside Python, since Python is what it provides.
# It also brings its own interpreter, which is why it is the only prerequisite.
if ! command -v uv >/dev/null 2>&1; then
  # Installed but absent from this shell's PATH needs the PATH fix, not a second install.
  # shellcheck disable=SC1091
  [[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "[setup] uv is not installed. It manages both the dependencies and the Python version."
  read -r -p "[setup] install uv from https://astral.sh/uv ? [Y/n] " reply
  [[ -z ${reply:-} || $reply =~ ^[Yy] ]] \
    || { echo "[setup] install it yourself: https://docs.astral.sh/uv/" >&2; exit 1; }
  curl -LsSf https://astral.sh/uv/install.sh | sh
  # shellcheck disable=SC1091
  [[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
  export PATH="$HOME/.local/bin:$PATH"
  command -v uv >/dev/null 2>&1 \
    || { echo "[setup] uv installed but not on PATH — open a new shell and re-run." >&2; exit 1; }
fi

exec uv run scripts/setup.py "$@"
