{
  "python_version": "3.12",
  "dependencies": [
    "."
  ],
  "graphs": {
    "agent": "./deep_life_sci/graph.py:make_graph"
  },
  "ui": {
    "agent": "./ui/ui.tsx"
  },
  "http": {
    "app": "./deep_life_sci/webapp.py:app",
    "disable_store": true
  },
  "store": {
    "ttl": {
      "refresh_on_read": true,
      "default_ttl": 43200,
      "sweep_interval_minutes": 60
    }
  },
  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "default_ttl": 43200,
      "sweep_interval_minutes": 60
    }
  },
  "env": ".env.deploy",
  "auth": {
    "path": "./deep_life_sci/auth.py:auth",
    "allow_langsmith_api_keys": true
  }
}
