# The launcher scripts are bash and are executed as bash, including under WSL2 and Git
# Bash on Windows. A CRLF checkout breaks them at the shebang — `\r` becomes part of the
# interpreter name — so their line endings are pinned regardless of core.autocrlf.
* text=auto
*.sh text eol=lf
setup_sci_agent text eol=lf
run_sci_agent text eol=lf
