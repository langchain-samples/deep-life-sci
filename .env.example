# Models — via the LangSmith LLM gateway (Anthropic-native path).
# Gateway compute is authenticated by OPENAI_API_KEY: this is the gateway service
# key (lsv2_sk_...), NOT an OpenAI key. LANGSMITH_API_KEY stays for tracing.
OPENAI_API_KEY=lsv2_sk_...
# Anthropic-native path — prompt caching does NOT survive the OpenAI-compatible
# /v1 path. No trailing /v1: the Anthropic SDK appends it.
LANGSMITH_GATEWAY_ANTHROPIC_URL=https://gateway.smith.langchain.com/anthropic

# Which model pair to use: 'anthropic' (Sonnet 4.6 + Haiku 4.5), 'mixed'
# (GPT-5.6 terra root + Haiku 4.5 subagents) or 'openai' (GPT-5.6 terra + luna).
# Override per-run:
#   MODEL_PROFILE=mixed uv run agent.py
MODEL_PROFILE=anthropic

# LangSmith tracing. LANGSMITH_API_KEY also provisions the sandbox.
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=science-agent

# Sandbox snapshot with the scientific/bio Python stack preinstalled (the pinned list
# lives in scripts/build_snapshot.py). Build it with `uv run build_snapshot.py`;
# without it each run pays the pip install instead.
SANDBOX_SNAPSHOT_NAME=pubmed-py-bio

# Host-side cache (data/) lifetime, in seconds. Unset tracks the sandbox's idle TTL
# (600s), refreshed on every hit, so a running thread stays warm and a thread resumed
# later refetches. `off` disables expiry and restores a permanent cache.
#   RESEARCH_AGENT_CACHE_TTL=off
# RESEARCH_AGENT_DATA_DIR moves the cache elsewhere — a scratch disk, or a fresh
# directory when you want cold-cache timings.

# NCBI E-utilities
# NCBI_API_KEY is optional; it raises the rate limit from 3 to 10 requests/sec.
# NCBI's usage policy asks that tool and email identify the caller.
NCBI_API_KEY=
NCBI_TOOL=pubmed_agent
NCBI_EMAIL=
