# One LangSmith key does models (through the gateway; see MODEL_ACCESS below), tracing and
# sandboxes; setup.py writes it to both names below.

LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true

# Tracing project, created on first trace. Use a distinct name per person in a shared workspace.
LANGSMITH_PROJECT=deep-life-sci

# Model calls take a LangSmith key
LANGSMITH_GATEWAY_API_KEY=lsv2_...

# Anthropic-native path (/v1 drops prompt caching). No trailing /v1 — the SDK appends it.
LANGSMITH_GATEWAY_ANTHROPIC_URL=https://gateway.smith.langchain.com/anthropic

# How model calls authenticate; setup.py asks. `gateway` (recommended) goes through the
# LangSmith LLM gateway with the key above, and provider keys stay in your LangSmith workspace.
# `direct` calls Anthropic, OpenAI or Amazon Bedrock with your own credentials below, for each
# provider models.yaml uses; LangSmith still does tracing and sandboxes.
MODEL_ACCESS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock: a Bedrock API key, or AWS_PROFILE for a signed-in AWS CLI profile (local runs only;
# a deployment needs the key), and the region: us-east-1, us-east-2 or us-west-2 only, where
# Bedrock's OpenAI-compatible endpoint (Mantle) runs. Left commented when unused: an empty
# AWS_BEARER_TOKEN_BEDROCK reads as a key to the AWS SDKs and overrides a profile.
#   AWS_BEARER_TOKEN_BEDROCK=
#   AWS_PROFILE=
#   AWS_REGION=us-east-1

# Models are set in models.yaml. These override it per role, e.g. for an eval sweep:
#   ROOT_MODEL=claude-sonnet-5   ROOT_PROVIDER=anthropic   ROOT_EFFORT=medium
#   (and SUBAGENT_/SEARCH_/JUDGE_ likewise; an empty *_EFFORT means none)

# Sandbox snapshot with the scientific/bio stack preinstalled; build it with build_snapshot.py.
SANDBOX_SNAPSHOT_NAME=pubmed-py-bio
# Sandboxes authenticate with LANGSMITH_API_KEY unless this overrides it. Sandbox names
# start with SANDBOX_NAME_PREFIX (default `pubmed`). scripts/deploy.py sets both for a
# deployment; neither needs setting for a local run.
#   LANGSMITH_SANDBOX_API_KEY=lsv2_...
#   SANDBOX_NAME_PREFIX=pubmed

# Host cache (data/) lifetime in seconds; unset tracks the sandbox idle TTL, `off` never expires.
#   DEEP_LIFE_SCI_CACHE_TTL=off
# DEEP_LIFE_SCI_DATA_DIR moves the cache elsewhere, e.g. for cold-cache timings.

# NCBI E-utilities. The key is optional (3 -> 10 req/sec); tool and email identify the caller.
# `NCBI_TOOL` is generated per install by setup.py — NCBI meters against it, so a name shared
# by every clone means one runaway loop throttles everyone. Change it only to something at
# least as specific.
NCBI_API_KEY=
NCBI_TOOL=
NCBI_EMAIL=

# Sign-in for a deployment (scripts/deploy.py --auth oidc), from any OpenID Connect provider,
# with the app registered as a single-page app. The issuer exactly as in its tokens' `iss`,
# e.g. https://login.microsoftonline.com/<tenant>/v2.0 or https://<org>.okta.com/oauth2/default.
# The UI sends ID tokens, whose audience is the client ID; set OIDC_TOKEN=access and
# OIDC_AUDIENCE to the API's identifier to send access tokens instead. Unused by local runs.
# Sign-in renews itself before tokens expire, through a hidden iframe unless the provider
# issues refresh tokens; browsers that block third-party cookies (Safari) refuse the iframe,
# and the page then asks the user to sign in again. To avoid that, enable refresh tokens
# for the app at the provider and add offline_access to OIDC_SCOPE.
#   OIDC_ISSUER=
#   OIDC_CLIENT_ID=
#   OIDC_ALLOWED_EMAIL_DOMAINS=example.edu
#   OIDC_SCOPE=openid profile email
#   OIDC_TOKEN=id
#   OIDC_AUDIENCE=

# Eval dataset prefix: datasets are `{prefix}-{seed stem}`. Suffix it per person if shared.
#   EVALS_DATASET_PREFIX=deep-life-sci-yourname
