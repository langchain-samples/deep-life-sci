#!/usr/bin/env bash
#
# Run the agent, for macOS and Linux. A convenience wrapper over the two commands Windows
# users run directly; the preflight checks these used to do now live in Python, so they
# apply on every platform.
#
#   ./run_deep_life_sci                          chat UI + graph server, Ctrl-C stops both
#   ./run_deep_life_sci "does X bind Y?"         one headless question, answer on stdout
#
# The chat UI opens in your browser once it is up; NO_BROWSER=1 leaves it closed.
# Environment passes through, so ROOT_MODEL=openai/gpt-5.6-terra ./run_deep_life_sci ... swaps
# the root model (SUBAGENT_/JUDGE_ too; see research_agent/models.py).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  [[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
  command -v uv >/dev/null 2>&1 \
    || { echo "[run] uv is not on your PATH. Run ./setup_deep_life_sci first." >&2; exit 1; }
fi

case "${1:-}" in
  -h|--help) sed -n '3,12p' "$0" | sed 's/^#\{1,\} \{0,1\}//'; exit 0 ;;
esac

# A question is what selects the headless path; with nothing to answer, the UI is the only
# sensible thing to do.
if [[ $# -gt 0 && ${1:-} != chat && ${1:-} != ui ]]; then
  exec uv run agent "$@"
fi
exec uv run scripts/dev.py
