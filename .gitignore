__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.env
.ruff_cache/
.pytest_cache/
.langgraph_api/
.DS_Store

# Node modules for the artifact components in ui/. The lockfile beside them IS tracked:
# langgraph.json bundles ui/ui.tsx at build time, and when that bundle is wrong the
# failure is silent — LoadExternalComponent paints an empty div, no console error, the
# run looks fine and the chart is just absent.
ui/node_modules/

# Host-side caches and probe notes. Not deliverables, and `data/` is 20M+ of fetched
# abstracts that anyone can re-fetch.
data/
docs/pubmed_api_notes/
docs/pmc_api_notes/

# Retired eval seed files kept on disk for reference, not synced or reviewed.
evals/datasets/archive/

# Coverage planning for the eval set: the question-type x domain grid and the candidate
# questions drawn from it. Planning notes, not seeds — a question only becomes real once
# its ground truth is verified and it lands in evals/datasets/*.jsonl.
evals/taxonomy/

# Scratch space for working out what the right answer to an eval question even is.
# Whatever survives belongs in the seed's `rubric` in evals/datasets/*.jsonl, which is
# the canonical store; these reports are the workings, not the answer.
evals/ground_truth_reports/
